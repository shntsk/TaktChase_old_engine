<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TaktChase.Game.Tests</AssemblyName>
    <RootNamespace>TaktChase.Game.Tests</RootNamespace>
    <!-- The project has its own Program.Main (visual test browser), as in the official template. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Versions identical to the official ppy.osu.Framework.Templates 2026.1008.0 template
      (osu.Framework.Templates/templates/template-empty/TemplateGame.Game.Tests.csproj).
      NUnit is NOT referenced here: the template does not reference it either. It arrives
      transitively through ppy.osu.Framework, whose published NuGet dependency is NUnit (>= 4.6.1).
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TaktChase.Game\TaktChase.Game.csproj" />
  </ItemGroup>
</Project>
